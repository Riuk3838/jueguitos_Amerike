* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: #0b0712;
  color: #ffffff;
  font-family: 'Press Start 2P', monospace;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 1000vh;
  padding: 20px;
}

/* Contenedor principal */
.window-container {
  width: 100%;
  max-width: 900px;
  min-height: 500px;
  border: 4px solid #00f3ff;
  box-shadow: 0 0 25px #00f3ff, inset 0 0 15px rgba(0, 243, 255, 0.2);
  background-color: #161024;
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  overflow: hidden;
}

/* Navbar */
.navbar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  gap: 15px;
  padding: 20px 15px;
  border-bottom: 4px solid #ff0077;
  background-color: #0d0818;
}

/* Botones estilo Arcade 3D */
.nav-btn {
  flex: 1;
  padding: 16px 10px;
  font-family: 'Press Start 2P', monospace;
  font-size: 11px;
  font-weight: bold;
  cursor: pointer;
  text-align: center;
  border-radius: 40px;
  border: 3px solid #ffffff;
  color: #ffffff;
  text-shadow: 2px 2px 0px #000000;
  position: relative;
  transition: all 0.1s ease;
  outline: none;
  opacity: 0.7;
}

/* Colores de los botones */
.btn-blue {
  background: linear-gradient(180deg, #00f3ff 0%, #0077b6 100%);
  box-shadow: 0 6px 0 #004466, 0 0 10px #00f3ff;
}

.btn-pink {
  background: linear-gradient(180deg, #ff0077 0%, #a1004a 100%);
  box-shadow: 0 6px 0 #5c002b, 0 0 10px #ff0077;
}

.btn-yellow {
  background: linear-gradient(180deg, #ffe600 0%, #b3a200 100%);
  color: #000000;
  text-shadow: none;
  box-shadow: 0 6px 0 #665c00, 0 0 10px #ffe600;
}

/* Botón Activo / Seleccionado */
.nav-btn.active {
  opacity: 1;
  transform: translateY(3px);
  filter: brightness(1.2);
}

.btn-blue.active { box-shadow: 0 3px 0 #004466, 0 0 15px #00f3ff; }
.btn-pink.active { box-shadow: 0 3px 0 #5c002b, 0 0 15px #ff0077; }
.btn-yellow.active { box-shadow: 0 3px 0 #665c00, 0 0 15px #ffe600; }

.nav-btn:hover {
  opacity: 1;
}

/* Área de Contenido */
.content-area {
  padding: 35px;
  flex: 1;
}

/* Ocultar secciones por defecto */
.section {
  display: none;
  line-height: 2;
  font-size: 13px;
}

/* Mostrar solo la sección activa */
.section.active {
  display: block;
  animation: fadeIn 0.3s ease-in-out;
}

/* Animación al cambiar de pantalla */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section h2 {
  font-size: 16px;
  margin-bottom: 25px;
}

.title-blue { color: #00f3ff; text-shadow: 0 0 8px #00f3ff; }
.title-pink { color: #ff0077; text-shadow: 0 0 8px #ff0077; }
.title-yellow { color: #ffe600; text-shadow: 0 0 8px #ffe600; }

.section p {
  text-transform: uppercase;
  margin-bottom: 20px;
  color: #e2e8f0;
}

.fin-text {
  margin-top: 30px;
  color: #00ff66;
  text-shadow: 0 0 8px #00ff66;
}